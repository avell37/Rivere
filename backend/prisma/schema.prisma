generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  username String  @unique
  email    String  @unique
  password String
  nickname String
  avatar   String?

  role UserRole @default(USER)

  authProvider AuthProvider @default(LOCAL)
  yandexId     String?      @unique

  tokens     Token[]
  isVerified Boolean @default(false) @map("is_verified")

  isEmailVerified Boolean @default(false) @map("is_email_verified")
  emailVerificationReminderAt DateTime? @map("email_verification_reminder_at")
  isTotpEnabled   Boolean @default(false) @map("is_totp_enabled")
  totpSecret      String? @map("totp_secret")

  bannedUntil DateTime? @map("banned_until")
  banReason   String?   @map("ban_reason")
  bannedAt    DateTime? @map("banned_at")

  userStats             UserStats?
  boards                BoardMember[]
  messages              Message[]
  boardInvitesCreated   BoardInvite[] @relation("BoardInvitesCreated")
  boardInvitesReceived  BoardInvite[] @relation("BoardInvitesReceived")
  notifications         Notification[]
  activityLogs          ActivityLog[]
  assignedCards         Card[]          @relation("CardAssignee")
  userAchievements      UserAchievements[]
  achievementProgresses AchievementProgress[]

  reportsCreated  Report[] @relation("ReportsCreated")
  reportsReceived Report[] @relation("ReportsReceived")
  reportsResolved Report[] @relation("ReportsResolved")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Token {
  id String @id @default(uuid())

  token     String    @unique
  type      TokenType
  expiresIn DateTime  @map("expires_in")

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tokens")
}

model UserStats {
  id String @id @default(uuid())

  totalCompletedCards Int @default(0)

  usersInvited Int @default(0)

  dailyCompletedCards Json      @default("{}")
  currentStreakDays   Int       @default(0)
  longestStreakDays   Int       @default(0)
  lastActiveDate      DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_stats")
}

model UserAchievements {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementId String   @map("achievement_id")
  achievedAt    DateTime @default(now()) @map("achieved_at")

  achievements Achievement @relation(fields: [achievementId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Board {
  id String @id @default(uuid())

  title String

  background Json

  columns      Column[]
  members      BoardMember[]
  boardInvites BoardInvite[]
  activityLogs ActivityLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("boards")
}

model BoardMember {
  id String @id @default(uuid())

  role       Role     @default(MEMBER)
  isFavorite Boolean  @default(false)
  joinedAt   DateTime @default(now())

  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId String @map("board_id")
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("board_members")
}

model BoardInvite {
  id String @id @default(uuid())

  token String @unique

  boardId String @map("board_id")
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdBy String @map("created_by")
  creator   User   @relation("BoardInvitesCreated", fields: [createdBy], references: [id], onDelete: Cascade)

  invitedUserId String? @map("invited_user_id")
  invitedUser   User?   @relation("BoardInvitesReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("board_invite")
}

model Column {
  id String @id @default(uuid())

  title    String
  position Int

  boardId String @map("board_id")
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards Card[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("columns")
}

model Card {
  id String @id @default(uuid())

  title       String
  description String?
  position    Int
  priority    Priority
  deadline    DateTime?
  done        Boolean   @default(false)

  deadlineNotifiedAt DateTime? @map("deadline_notified_at")

  assigneeId String? @map("assignee_id")
  assignee   User?   @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  tags Tag[]

  chat Chat?

  columnId String @map("column_id")
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cards")
}

model Tag {
  id String @id @default(uuid())

  title      String
  background String

  cardId String @map("card_id")
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tags")
}

model Chat {
  id String @id @default(uuid())

  messages Message[]

  cardId String @unique
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat")
}

model Message {
  id String @id @default(uuid())

  text String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId String

  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("messages")
}

model ActivityLog {
  id String @id @default(uuid())

  action   ActivityAction
  entityType ActivityEntity
  entityId   String?        @map("entity_id")
  entityTitle String?       @map("entity_title")
  meta        Json?

  boardId String @map("board_id")
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

model Notification {
  id String @id @default(uuid())

  userId   String
  type     String
  message  String?
  messageKey String? @map("message_key")
  messageParams Json? @map("message_params")
  entityId String?
  read     Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Achievement {
  id String @id @default(uuid())

  code        String @unique
  title       String
  description String
  goal        Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      UserAchievements[]
  progresses AchievementProgress[]

  @@map("achievements")
}

model AchievementProgress {
  id String @id @default(uuid())

  progress Int

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementId String      @map("achievement_id")
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, achievementId])
  @@map("achievement_progress")
}

enum ReportTargetType {
  MESSAGE
  USER
  CARD
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportResolutionAction {
  NONE
  BAN_USER
  DELETE_MESSAGE
  DELETE_CARD
}

model Report {
  id String @id @default(uuid())

  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id")
  reason     String
  details    String?

  snapshot Json?

  status ReportStatus @default(OPEN)

  reporterId String @map("reporter_id")
  reporter   User   @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)

  reportedUserId String? @map("reported_user_id")
  reportedUser   User?   @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)

  resolvedById String? @map("resolved_by_id")
  resolvedBy   User?   @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime? @map("resolved_at")
  resolutionNote String? @map("resolution_note")
  resolutionAction ReportResolutionAction? @map("resolution_action")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([reporterId, targetType, targetId])
  @@map("reports")
}

enum UserRole {
  USER
  CREATOR
  ADMIN
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum AuthProvider {
  LOCAL
  YANDEX
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET

  @@map("tokens_types")
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  MOVED
  COMPLETED
  REOPENED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_ROLE_CHANGED
  BOARD_UPDATED
}

enum ActivityEntity {
  BOARD
  COLUMN
  CARD
  MEMBER
}
